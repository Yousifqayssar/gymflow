# Copy this file to .env and adjust the values. Never commit .env.

# Environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# URL of the React app, allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Must match the POSTGRES_* values in the root .env used by docker-compose.
DATABASE_URL=postgresql://gymflow:change_me@localhost:5432/gymflow

# Secret key for signing login tokens (JWT). At least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars

# How long a login stays valid (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d

# First Admin account, created by `npm run db:seed`.
# Choose your own password (at least 8 characters).
SEED_ADMIN_EMAIL=admin@gymflow.local
SEED_ADMIN_PASSWORD=change_me_admin_password
