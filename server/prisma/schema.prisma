// Prisma schema: describes the database tables (models) for GymFlow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The three kinds of users in the system.
enum Role {
  ADMIN
  TRAINER
  MEMBER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  // Only the bcrypt hash is stored, never the real password.
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(MEMBER)
  // Secret, random content of the member's personal QR code (never the id, so it cannot be guessed).
  // Generated by the database, so existing users also got one when this column was added.
  qrToken      String   @unique @default(dbgenerated("gen_random_uuid()::text"))
  // The avatar the user picked, e.g. "notionists-felix" or "badge-dumbbell" (see src/utils/avatars.js).
  // Empty = show the initials.
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  // Classes this user teaches (trainers) and classes this user booked (members).
  taughtClasses    GymClass[]   @relation("ClassTrainer")
  bookings         Booking[]
  // Gym visits of this member, and check-ins this staff member recorded.
  checkIns         CheckIn[]    @relation("MemberCheckIns")
  recordedCheckIns CheckIn[]    @relation("StaffCheckIns")
}

// A product the gym sells, e.g. "3 Months – 2500 TRY".
// Plans are never deleted once used; they are deactivated (isActive = false).
model MembershipPlan {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  // What the plan includes, shown to members (may be empty for older plans).
  description    String   @default("")
  // Must be > 0 (database check constraint in the migration).
  durationMonths Int
  // Exact decimal for money, never a floating-point number. Must be > 0.
  price          Decimal  @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]
}

// A plan sold to one member for a specific period.
// The status (active, expiring soon, expired) is calculated from the dates, not stored.
model Membership {
  id        Int            @id @default(autoincrement())
  userId    Int
  // Deleting a user also deletes their memberships.
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    Int
  plan      MembershipPlan @relation(fields: [planId], references: [id])
  // Calendar dates without time. Valid from startDate to endDate, both inclusive.
  startDate DateTime       @db.Date
  // Always after startDate (database check constraint in the migration).
  endDate   DateTime       @db.Date
  // The price at the time of sale, so later price changes don't rewrite history.
  price     Decimal        @db.Decimal(10, 2)
  // Loyalty discount the member got on this sale (0, 5, 10 or 15 %), already included in `price`.
  discountPercent Int      @default(0)
  createdAt DateTime       @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Classes (group activities) and bookings
// ---------------------------------------------------------------------------

// The kind of activity; decides the icon and colour in the app.
enum ClassCategory {
  RUNNING
  YOGA
  HIIT
  CYCLING
  PILATES
  BOXING
  STRENGTH
  MOBILITY
}

enum ClassLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum ClassIntensity {
  LOW
  MEDIUM
  HIGH
}

// One session of a group class, e.g. "Running Club" on Saturday 24 October at 08:00.
// Everything a member needs to decide whether to book is stored here.
model GymClass {
  id              Int            @id @default(autoincrement())
  title           String
  category        ClassCategory
  // What happens in the class, in plain language.
  description     String
  // Where to meet, e.g. "Studio 2" or "Bebek Park, main entrance".
  location        String
  // The exact moment the class starts (stored with time zone).
  startsAt        DateTime       @db.Timestamptz(3)
  // 15–300 minutes (database check constraint in the migration).
  durationMinutes Int
  // Maximum number of bookings; > 0 (database check constraint).
  capacity        Int
  level           ClassLevel
  intensity       ClassIntensity
  whatToBring     String         @default("")
  // Who should be careful or not join, e.g. "Not suitable for knee injuries".
  healthNotes     String         @default("")
  // A class with bookings is cancelled, never deleted, so members can see what happened.
  isCancelled     Boolean        @default(false)
  trainerId       Int
  // A trainer who still has classes cannot be deleted (RESTRICT).
  trainer         User           @relation("ClassTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  bookings        Booking[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([startsAt])
  @@index([trainerId])
}

// A member's spot in a class.
model Booking {
  id        Int      @id @default(autoincrement())
  classId   Int
  gymClass  GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId  Int
  member    User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Business rule "a member cannot book the same class twice", enforced by the database.
  @@unique([classId, memberId])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Check-ins (gym visits)
// ---------------------------------------------------------------------------

enum CheckInMethod {
  QR // the member's QR code was scanned
  MANUAL // staff typed the member number
}

// One visit of a member to the gym. Points are calculated from visits (10 per visit), not stored.
model CheckIn {
  id            Int           @id @default(autoincrement())
  memberId      Int
  member        User          @relation("MemberCheckIns", fields: [memberId], references: [id], onDelete: Cascade)
  // The exact moment of the check-in.
  checkedInAt   DateTime      @default(now()) @db.Timestamptz(3)
  // The calendar day in the gym's time zone. Together with memberId it is unique:
  // a member can be checked in (and earn points) only once per day.
  gymDay        DateTime      @db.Date
  method        CheckInMethod
  // The staff member who checked the member in (kept as empty if that account is deleted).
  checkedInById Int?
  checkedInBy   User?         @relation("StaffCheckIns", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@unique([memberId, gymDay])
  @@index([gymDay])
}
