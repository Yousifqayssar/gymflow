// Prisma schema: describes the database tables (models) for GymFlow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The three kinds of users in the system.
enum Role {
  ADMIN
  TRAINER
  MEMBER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  // Only the bcrypt hash is stored, never the real password.
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
