{
  "name": "gymflow-server",
  "version": "0.1.0",
  "description": "GymFlow REST API (Express + Prisma + PostgreSQL)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:demo": "node prisma/seed-demo.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
