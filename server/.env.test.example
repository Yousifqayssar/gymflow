# Settings used only when running tests (npm test).
# Copy this file to .env.test. Never commit .env.test.

NODE_ENV=test

# A SEPARATE database for tests. Its name must end with "_test":
# the tests delete all data in it before each test.
# It is created automatically the first time you run the tests.
DATABASE_URL=postgresql://gymflow:change_me@localhost:5432/gymflow_test
