# Dependencies
node_modules/

# Environment files (real secrets never go into git; only .env.example is committed)
.env
.env.*
!.env.example
!.env.test.example

# Generated Prisma client (recreated by `npx prisma generate`)
server/src/generated/

# Build output
dist/
build/
coverage/

# Test reports (Playwright, later)
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*

# Lock files of open documents (LibreOffice / Microsoft Office)
.~lock.*#
~$*

# Editor / OS files
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
.DS_Store
Thumbs.db
